{
  "name": "fairshop-processor-reserves",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairshop-processor-reserves",
  "description": "Tracks reserves and holds in Stripe, PayPal and Shopify balance exports against the reserve terms you confirm: releases overdue, holds above your terms, releases coming up, and dispute holds open too long. Drafts a release inquiry per processor; never moves money.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairshop-processor-reserves": "bin/fairshop-processor-reserves.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairshop-processor-reserves.js demo",
    "eval": "node bin/fairshop-processor-reserves.js eval"
  },
  "dependencies": {
    "fairshop-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairshop-agents.git",
    "directory": "packages/fairshop-processor-reserves"
  },
  "homepage": "https://github.com/fpavia111-creator/fairshop-agents/tree/main/packages/fairshop-processor-reserves#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairshop-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ecommerce",
    "retail",
    "fairshop",
    "stripe",
    "paypal",
    "reserves",
    "rolling-reserve",
    "payment-holds"
  ]
}

        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lines": 6,
          "result.dispute": 3,
          "result.chase": 1,
          "result.review": 1,
          "result.ok": 1,
          "result.to_claim": 474
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"match-totals\"."

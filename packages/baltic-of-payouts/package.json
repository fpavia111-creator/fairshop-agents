{
  "name": "baltic-of-payouts",
  "version": "0.1.0",
  "description": "Baltic of Payouts: matches every order to the payout lines from Shopify Payments, Stripe, PayPal, Amazon, eBay, Etsy and Walmart exports, by channel: orders never paid out, paid short, paid twice, refunds not yet deducted, fees above your rate and payout lines with no order. Drafts an inquiry per channel; never contacts support or moves money.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "baltic-of-payouts": "bin/baltic-of-payouts.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/baltic-of-payouts.js demo",
    "eval": "node bin/baltic-of-payouts.js eval"
  },
  "dependencies": {
    "fairshop-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairshop-agents.git",
    "directory": "packages/baltic-of-payouts"
  },
  "homepage": "https://github.com/fpavia111-creator/fairshop-agents/tree/main/packages/baltic-of-payouts#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairshop-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ecommerce",
    "retail",
    "fairshop",
    "payouts",
    "reconciliation",
    "shopify",
    "amazon-settlement",
    "stripe",
    "paypal"
  ]
}

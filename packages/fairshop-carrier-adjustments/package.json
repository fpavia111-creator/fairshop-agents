{
  "name": "fairshop-carrier-adjustments",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairshop-carrier-adjustments",
  "description": "Checks carrier adjustments (UPS, FedEx, USPS) against the weights and dimensions you entered on the label: adjustments your own data disproves, with a dispute-by date, adjustments that are right because your product data is wrong (and the SKUs that keep causing them), address corrections, and adjustments past their window. Drafts the dispute; never files it or pays.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairshop-carrier-adjustments": "bin/fairshop-carrier-adjustments.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairshop-carrier-adjustments.js demo",
    "eval": "node bin/fairshop-carrier-adjustments.js eval"
  },
  "dependencies": {
    "fairshop-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairshop-agents.git",
    "directory": "packages/fairshop-carrier-adjustments"
  },
  "homepage": "https://github.com/fpavia111-creator/fairshop-agents/tree/main/packages/fairshop-carrier-adjustments#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairshop-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ecommerce",
    "retail",
    "fairshop",
    "carrier-adjustments",
    "dim-weight",
    "usps-apv",
    "ups",
    "fedex"
  ]
}

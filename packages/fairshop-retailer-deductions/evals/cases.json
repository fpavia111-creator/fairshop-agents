      }
    },
    {
      "id": "gen-wrong-type",
      "tool": "deductions_audit",
      "args": {
        "deductions": 42,
        "invoices": "fixtures/invoices.csv",
        "pods": "fixtures/pods.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "deductions"
        ]
      }
    },
    {
      "id": "gen-missing-arg",
      "tool": "deductions_audit",
      "args": {
        "invoices": "fixtures/invoices.csv",
        "pods": "fixtures/pods.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "deductions"
        ]
      }
    },
    {
      "id": "gen-explain-unknown",
      "tool": "deductions_explain",
      "args": {
        "deductions": "fixtures/deductions.csv",
        "invoices": "fixtures/invoices.csv",
        "pods": "fixtures/pods.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16",
        "invoice_number": "NO-SUCH-ITEM-0000"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found"
        ]
      }
    },
    {
      "id": "intl-de-audit-totals",
      "tool": "deductions_audit",
      "args": {
        "deductions": "fixtures/intl/de/deductions.csv",
        "invoices": "fixtures/intl/de/invoices.csv",
        "pods": "fixtures/intl/de/pods.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.deductions": 8,
          "result.dispute": 3,
          "result.review": 2,
          "result.write_off": 1,
          "result.window_closed": 1,
          "result.ok": 1,
          "result.to_dispute": 750,
          "result.deducted": 1408
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"audit-totals\"."

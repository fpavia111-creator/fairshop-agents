{
  "name": "fairshop-agents",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fairshop-agents",
      "license": "MIT",
      "workspaces": [
        "packages/fairshop-core",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/fairshop-core": {
      "resolved": "packages/fairshop-core",
      "link": true
    },
    "packages/fairshop-core": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "fairshop-approve": "bin/fairshop-approve.js",
        "fairshop-license": "bin/fairshop-license.js",
        "fairshop-new-agent": "bin/fairshop-new-agent.js",
        "fairshop-verify-log": "bin/fairshop-verify-log.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
